<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <ApplicationIcon>Resources\Icon.ico</ApplicationIcon>
        
        <OutputType>WinExe</OutputType>

        <PreserveCompilationContext>false</PreserveCompilationContext>
        <UseWPF>true</UseWPF>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <FileAlignment>512</FileAlignment>
        <Deterministic>true</Deterministic>

        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
        <AllowedReferenceRelatedFileExtensions>None</AllowedReferenceRelatedFileExtensions>
        <NoWarn>$(NoWarn);CA1416</NoWarn>
        <NoWarn>$(NoWarn);VSTHRD003</NoWarn>
        <NoWarn>$(NoWarn);VSTHRD110</NoWarn>
        <NoWarn>$(NoWarn);MSB3539</NoWarn>
    </PropertyGroup>
    
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>None</DebugType>
        <Optimize>true</Optimize>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>

    <!-- WorldForge ships to players with the client through Kesmai.Update, as one framework-dependent
         Kesmai.WorldForge.exe (players install the client's Desktop Runtime). A publish for a runtime,
         dotnet publish -c Release -r win-x64, bundles every assembly and native library into the exe and writes it to
         Build/Kesmai.WorldForge/Publish, where Kesmai's Build-Stage-Publish.ps1 stages it next to the client. Only the
         content archives (*.bin) stay beside it. Kesmai.Client.Package lists only the folder's own files, so the
         publish must not need anything else. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>false</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <PublishDir>$(BuildRoot)Kesmai.WorldForge\Publish\</PublishDir>
    </PropertyGroup>
    
    <ItemGroup>
      <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
      <PackageReference Include="CommonServiceLocator" Version="2.0.6" />
      <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
      <PackageReference Include="Dirkster.AvalonDock" Version="4.50.2" />
      <PackageReference Include="Extended.Wpf.Toolkit" Version="5.0.0" />
      <PackageReference Include="MonoGame.Framework.WindowsDX" Version="$(MonoGameVersion)" />
      <!-- DigitalRune.Graphics.Interop (D3D11Image) shares its surface with WPF through Direct3D 9, and MonoGame
           doesn't bring SharpDX.Direct3D9 in. Same version as MonoGame's SharpDX. -->
      <PackageReference Include="SharpDX.Direct3D9" Version="4.2.0" />
      <PackageReference Include="NuGet.Frameworks" Version="6.14.0" />
      <PackageReference Include="NuGet.Resolver" Version="6.14.0" />
      <PackageReference Include="RoslynPad.Editor.Windows" Version="4.12.1" />
      <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="DigitalRune">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Animation">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Animation.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Game">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Game.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Game.Interop">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Game.Interop.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Game.Input">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Game.Input.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Game.UI">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Game.UI.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Geometry">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Geometry.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Graphics">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Graphics.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Graphics.Interop">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Graphics.Interop.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Mathematics">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Mathematics.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.Particles">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.Particles.dll</HintPath>
      </Reference>
      <Reference Include="DigitalRune.ServiceLocation">
        <HintPath>..\..\Dependencies\DigitalRune\DigitalRune.ServiceLocation.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <ApplicationDefinition Include="Core.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
      </ApplicationDefinition>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Resources\*.*" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="obj\**" />
      <EmbeddedResource Remove="obj\**" />
      <None Remove="obj\**" />
      <Page Remove="obj\**" />
    </ItemGroup>

    <PropertyGroup>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>

    <!-- Content archives (Data.bin, Kesmai.bin, Stormhalter.bin, UI.bin). WorldForge loads them from its own folder.
         With a Kesmai checkout, building WorldForge builds them and copies them here. The checkout is
         found next to this repository: a Stormhalter-<name> folder uses a sibling Kesmai-<name> when one exists,
         otherwise the sibling Kesmai. Override with -p:KesmaiPath=<path>. Without one, copy the archives from a
         client installation. -->
    <PropertyGroup>
        <StormhalterDirectoryName>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetFullPath('$(SolutionDir)..'))))</StormhalterDirectoryName>
        <KesmaiWorktreePath Condition="$(StormhalterDirectoryName.StartsWith('Stormhalter-'))">$([System.IO.Path]::GetFullPath('$(SolutionDir)../../Kesmai-$(StormhalterDirectoryName.Substring(12))'))</KesmaiWorktreePath>
        <KesmaiPath Condition="'$(KesmaiPath)' == '' and '$(KesmaiWorktreePath)' != '' and Exists('$(KesmaiWorktreePath)')">$(KesmaiWorktreePath)</KesmaiPath>
        <KesmaiPath Condition="'$(KesmaiPath)' == ''">$([System.IO.Path]::GetFullPath('$(SolutionDir)../../Kesmai'))</KesmaiPath>
        <KesmaiContentTargets>$(KesmaiPath)/Source/Kesmai.Content/Kesmai.Content.targets</KesmaiContentTargets>
    </PropertyGroup>

    <Import Project="$(KesmaiContentTargets)" Condition="Exists('$(KesmaiContentTargets)')" />

    <!-- Visual Studio and Rider build the solution's projects themselves and pass BuildProjectReferences=false, and
         Kesmai.Content isn't in Kesmai.WorldForge.sln, so they would never build the archives. Build it here then,
         with its own references, and without the solution's properties (they would move Kesmai's paths). -->
    <Target Name="BuildKesmaiContentOutsideSolution" BeforeTargets="ResolveProjectReferences"
            Condition="'$(BuildProjectReferences)' == 'false' and Exists('$(KesmaiContentTargets)')">
        <MSBuild Projects="$(KesmaiPath)/Source/Kesmai.Content/Kesmai.Content.csproj" Targets="Build"
                 Properties="Configuration=$(Configuration);BuildProjectReferences=true"
                 RemoveProperties="TargetFramework;RuntimeIdentifier;SolutionDir;SolutionPath;SolutionName;SolutionFileName;SolutionExt" />
    </Target>

    <Target Name="ReportMissingContentArchives" BeforeTargets="Build" Condition="!Exists('$(KesmaiContentTargets)')">
        <Message Importance="high" Text="No Kesmai checkout at '$(KesmaiPath)', so the content archives were not built. Copy Data.bin, Kesmai.bin, Stormhalter.bin and UI.bin from a client installation, or set KesmaiPath." />
    </Target>

    <Target Name="CleanupAfterPublish" AfterTargets="Publish">
        <!-- Clean-up: the single-file publish has bundled the references; remove any copy left beside the exe. -->
        <Message Text="Deleting reference: @(ReferenceCopyLocalPaths->'$(PublishDir)%(Filename)%(Extension)')" />
        <Delete Files="@(ReferenceCopyLocalPaths->'$(PublishDir)%(Filename)%(Extension)')" ContinueOnError="WarnAndContinue" />
    </Target>
</Project>
