<UserControl x:Class="Kesmai.WorldForge.UI.OnSpawnAssetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wpfToolkit="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="340"
             FontFamily="Tahoma" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,6,3" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,3,0,3" />
            <Setter Property="Padding" Value="8,1" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock x:Name="_status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="4" Foreground="DimGray" FontSize="11" />

        <TabControl x:Name="_tabs" Margin="2">
            <!-- Builder: the whole OnSpawn as a form. Read fills it from the script, Write replaces the script. -->
            <TabItem Header="Builder">
                <DockPanel x:Name="_builderRoot" Margin="4">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Read from OnSpawn" Click="OnBuilderRead" Margin="0,3" />
                            <Button Content="Write to OnSpawn" Click="OnBuilderWrite" FontWeight="Bold" />
                        </StackPanel>
                        <Expander Header="Code preview" IsExpanded="True">
                            <TextBox x:Name="_builderPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="220"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </Expander>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Expander Header="Identity" IsExpanded="True">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Class" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="_bCreature" Text="{Binding CreatureType, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Variable" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding Variable, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Alignment" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="_bAlignment" Text="{Binding Alignment, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Expander>

                            <Expander Header="Body and hue" IsExpanded="True">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Body" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Grid.Row="0" Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="Use selected body" Click="OnBuilderUseBody" />
                                        <TextBox Margin="0,3" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="Hue" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="_bHueMode" IsEditable="False" SelectedItem="{Binding HueMode}" />
                                    <TextBlock Grid.Row="2" Text="Color name" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="_bHueName" Text="{Binding HueName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="A R G B" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Grid.Row="3" Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="From Hue tab" Click="OnBuilderUsePickerHue" />
                                        <UniformGrid Columns="4">
                                            <TextBox Margin="0,3,2,3" Text="{Binding HueA, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,3,2,3" Text="{Binding HueR, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,3,2,3" Text="{Binding HueG, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,3,2,3" Text="{Binding HueB, UpdateSourceTrigger=PropertyChanged}" />
                                        </UniformGrid>
                                    </DockPanel>
                                </Grid>
                            </Expander>

                            <Expander Header="Stats" IsExpanded="True">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Max health" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3" Text="{Binding MaxHealth, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Base dodge" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding BaseDodge, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Experience" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding Experience, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Movement" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding Movement, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="4" Text="Shield penetration" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="_bPenetration" Text="{Binding Penetration, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="5" Text="Target strategy" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="_bSearch" Text="{Binding SearchStrategy, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Expander>

                            <Expander Header="Flags, immunity and weakness">
                                <StackPanel Margin="4">
                                    <TextBlock Text="A filled box leaves the class default." Foreground="DimGray" FontSize="11" />
                                    <ItemsControl ItemsSource="{Binding Flags}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsThreeState="True" Margin="0,2,10,2" />
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Immunity" FontWeight="Bold" Margin="0,6,0,0" />
                                    <ItemsControl ItemsSource="{Binding Immunities}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,2,10,2" />
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Weakness" FontWeight="Bold" Margin="0,6,0,0" />
                                    <ItemsControl ItemsSource="{Binding Weaknesses}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,2,10,2" />
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Attacks" IsExpanded="True">
                                <StackPanel Margin="4">
                                    <DataGrid ItemsSource="{Binding Attacks}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="60">
                                        <DataGrid.Columns>
                                            <DataGridComboBoxColumn x:Name="_bAttackType" Header="Type" SelectedItemBinding="{Binding Type}" />
                                            <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" />
                                            <DataGridTextColumn Header="Min" Binding="{Binding MinDamage}" />
                                            <DataGridTextColumn Header="Max" Binding="{Binding MaxDamage}" />
                                            <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" />
                                            <DataGridComboBoxColumn x:Name="_bAttackEffect" Header="Effect" SelectedItemBinding="{Binding Effect}" />
                                            <DataGridTextColumn Header="Chance / value" Binding="{Binding EffectValue1}" />
                                            <DataGridTextColumn Header="Value 2" Binding="{Binding EffectValue2}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Effects: daze and prone take a chance; poison takes potency, chance; age takes amount, chance."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="Blocks" FontWeight="Bold" Margin="0,6,0,0" />
                                    <DataGrid ItemsSource="{Binding Blocks}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="60">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Roll" Binding="{Binding Roll}" />
                                            <DataGridTextColumn Header="Blocked by" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Spells">
                                <DataGrid Margin="4" ItemsSource="{Binding Spells}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                          HeadersVisibility="Column" MinHeight="60">
                                    <DataGrid.Columns>
                                        <DataGridComboBoxColumn x:Name="_bSpell" Header="Spell" SelectedItemBinding="{Binding Spell}" />
                                        <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" />
                                        <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" />
                                        <DataGridTextColumn Header="Cooldown (s)" Binding="{Binding Cooldown}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>

                            <Expander Header="Gear and brain" IsExpanded="True">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Weapon" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="_bWeapon" Text="{Binding Weapon, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Shield" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="_bShield" Text="{Binding Shield, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Armor / robe" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="_bArmor" Text="{Binding Armor, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Helmet" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="_bHelmet" Text="{Binding Helmet, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="4" Text="Gauntlets" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="_bGauntlets" Text="{Binding Gauntlets, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="5" Text="Boots" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="_bBoots" Text="{Binding Boots, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="6" Text="Brain (AI)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="_bBrain" Text="{Binding Brain, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Expander>

                            <Expander Header="Loot" IsExpanded="True">
                                <StackPanel Margin="4">
                                    <DockPanel>
                                        <TextBlock Text="Gold" Style="{StaticResource FieldLabel}" />
                                        <TextBox Margin="0,3" Text="{Binding Gold, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding Loot}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="60">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="At spawn" Binding="{Binding AtSpawn}" />
                                            <DataGridTextColumn Header="Loot pack or item" Binding="{Binding Item}" Width="*" />
                                            <DataGridTextColumn Header="Chance" Binding="{Binding Chance}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Loot packs like KeshmaiOre are defined in your segment, so type their names."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Creature options: each row edits one line of the OnSpawn script -->
            <TabItem Header="Creature">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="_optionsGrid" Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Body">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="_bodySearch" TextChanged="OnBodySearchChanged" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Double-click a body to set Body = id." Foreground="DimGray" FontSize="11" Margin="0,4,0,0" />
                    <ListBox x:Name="_bodies"
                             MouseDoubleClick="OnBodyDoubleClick"
                             SelectionChanged="OnBodySelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <wpfToolkit:VirtualizingWrapPanel SpacingMode="None" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="78" ToolTip="{Binding Texture}">
                                    <Border Width="64" Height="64" Background="#FFE8E8E8">
                                        <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <TabItem Header="Hue">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6">
                        <Border Width="192" Height="192" HorizontalAlignment="Left" Background="#FFE8E8E8" BorderBrush="Gray" BorderThickness="1">
                            <Image x:Name="_huePreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border>
                        <TextBlock x:Name="_huePreviewLabel" Foreground="DimGray" FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap" />

                        <TextBlock Text="Named color" FontWeight="Bold" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Set" Click="OnSetNamedHue" />
                            <ComboBox x:Name="_hueNames" SelectionChanged="OnHueNameChanged" />
                        </DockPanel>

                        <TextBlock Text="Custom ARGB" FontWeight="Bold" Margin="0,10,0,0" />
                        <xctk:ColorPicker x:Name="_huePicker" UsingAlphaChannel="True" DisplayColorAndName="True"
                                          SelectedColorChanged="OnHueColorChanged" Margin="0,3" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Set" Click="OnSetCustomHue" />
                            <TextBlock x:Name="_hueArgb" FontFamily="Consolas" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="The preview multiplies the body by the hue. White leaves it unchanged."
                                   Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Sounds">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="_soundSearch" TextChanged="OnSoundSearchChanged" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="DimGray" FontSize="11" Margin="0,4,0,0"
                               Text="A creature's attack and death sounds come from its class, so OnSpawn can't set them. Copy an id for traps, OnDeath and other scripts." />
                    <ListView x:Name="_sounds">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="▶" Click="OnPlaySound" Margin="0,1,6,1" ToolTip="Play" />
                                    <Button DockPanel.Dock="Right" Content="Copy id" Click="OnCopySoundId" Margin="6,1,0,1" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Id, Mode=OneWay}" FontFamily="Consolas" />
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Category, Mode=OneWay}" Foreground="Gray" FontSize="10" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
