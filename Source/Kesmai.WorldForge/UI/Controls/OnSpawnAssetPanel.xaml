<UserControl x:Class="Kesmai.WorldForge.UI.OnSpawnAssetPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wpfToolkit="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:local="clr-namespace:Kesmai.WorldForge.UI"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="340"
             FontFamily="Tahoma" FontSize="13">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,6,3" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SmallCaps">
            <Setter Property="Foreground" Value="DimGray" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,1" />
        </Style>
        <!-- transparent-pixel checkerboard behind the sprite preview -->
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFE8E8E8" Geometry="M0,0 H2 V2 H0 Z" />
                    <GeometryDrawing Brush="#FFC4C4C4" Geometry="M0,0 H1 V1 H0 Z M1,1 H2 V2 H1 Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="IsEditable" Value="True" />
            <Setter Property="IsTextSearchEnabled" Value="True" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4,3,0,3" />
            <Setter Property="Padding" Value="8,1" />
        </Style>
        <Style TargetType="TextBox" x:Key="CodeBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MaxHeight" Value="200" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <!-- a sound in the builder's dropdowns: its id, which is what gets written, then its name -->
        <DataTemplate x:Key="SoundChoice">
            <TextBlock>
                <Run Text="{Binding Id, Mode=OneWay}" FontFamily="Consolas" />
                <Run Text="{Binding Name, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock x:Name="_status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="4" Foreground="DimGray" FontSize="11" />

        <TabControl x:Name="_tabs" Margin="2">
            <!-- Builder: the whole OnSpawn as a form. Read fills it from the script, Write replaces the script. -->
            <TabItem Header="Builder">
                <DockPanel x:Name="_builderRoot" Margin="4">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Read from OnSpawn" Click="OnBuilderRead" Margin="0,3" />
                            <Button Content="Write to OnSpawn" Click="OnBuilderWrite" FontWeight="Bold" />
                        </StackPanel>
                        <Expander Header="Code preview" IsExpanded="True">
                            <TextBox x:Name="_builderPreview" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Height="220"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AcceptsReturn="True" />
                        </Expander>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- the CreatureDTO.SetCreatureValues values that have no field elsewhere; Name, Body, Level, stats and sounds use theirs -->
                            <Expander Header="CreatureDTO" IsExpanded="True">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDto}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Expander.Style>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="The script sets these with creatureDTO.SetCreatureValues. Name, Body, Level, Max health, Max mana, Experience, Movement, Hide detection, Visibility distance (visibilty), Vision range and the sounds are in their own fields." />
                                                <Setter Property="Foreground" Value="DimGray" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDtoOnly}" Value="True">
                                                        <Setter Property="Text" Value="This OnSpawn picks between creatures with if or switch, so only its CreatureDTO values are written: these, plus Name, Body, Level, Max health, Max mana, Experience, Movement, Hide detection, Visibility distance, Vision range and the sounds. Everything else in the script stays exactly as typed, and the other builder fields aren't written." />
                                                        <Setter Property="Foreground" Value="DarkGoldenrod" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="1" Text="Alignment" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding DtoAlignment, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="1 = Chaotic (yellow), 2 = Evil (red), anything else = Lawful" />
                                    <TextBlock Grid.Row="2" Text="Attack" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding DtoAttack, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="creatureDTO.Attack; the attacks below often scale from it, for example creatureDTO.Attack*2" />
                                    <TextBlock Grid.Row="3" Text="Defense" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding DtoDefense, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Expander>

                            <Expander Header="Identity" IsExpanded="True">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Class" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="_bCreature" Text="{Binding CreatureType, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Class arguments" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding ConstructorArguments, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="What goes in new Class(...), for example creatureDTO, true" />
                                    <TextBlock Grid.Row="2" Text="Variable" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding Variable, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="4" Text="Alignment" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="_bAlignment" Text="{Binding Alignment, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="5" Text="Level" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Expander>

                            <Expander Header="Body and hue" IsExpanded="True">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Body" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Grid.Row="0" Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="From Body &amp; Hue tab" Click="OnBuilderUseBody" />
                                        <TextBox Margin="0,3" Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="1" Text="Hue" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="_bHueMode" IsEditable="False" SelectedItem="{Binding HueMode}" />
                                    <TextBlock Grid.Row="2" Text="Color name" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="_bHueName" Text="{Binding HueName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="A R G B" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Grid.Row="3" Grid.Column="1">
                                        <Button DockPanel.Dock="Right" Content="From Body &amp; Hue tab" Click="OnBuilderUsePickerHue" />
                                        <UniformGrid Columns="4">
                                            <TextBox Margin="0,3,2,3" Text="{Binding HueA, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,3,2,3" Text="{Binding HueR, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,3,2,3" Text="{Binding HueG, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBox Margin="0,3,2,3" Text="{Binding HueB, UpdateSourceTrigger=PropertyChanged}" />
                                        </UniformGrid>
                                    </DockPanel>
                                </Grid>
                            </Expander>

                            <Expander Header="Stats" IsExpanded="True">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Max health" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3" Text="{Binding MaxHealth, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Max mana" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,3" Text="{Binding MaxMana, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Base dodge" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding BaseDodge, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Experience" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,3" Text="{Binding Experience, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="4" Text="Movement" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Text="{Binding Movement, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="5" Text="Hide detection" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3" Text="{Binding HideDetection, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="6" Text="Visibility distance" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,3" Text="{Binding VisibilityDistance, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="7" Text="Vision range" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="7" Grid.Column="1" Margin="0,3" Text="{Binding VisionRange, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="8" Text="Range perception" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="8" Grid.Column="1" Margin="0,3" Text="{Binding RangePerception, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="9" Text="Shield penetration" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="9" Grid.Column="1" x:Name="_bPenetration" Text="{Binding Penetration, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="10" Text="Target strategy" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="10" Grid.Column="1" x:Name="_bSearch" Text="{Binding SearchStrategy, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="11" Text="Target change interval" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="11" Grid.Column="1" Margin="0,3" Text="{Binding TargetChangeInterval, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="CombatantChangeInterval, for example TimeSpan.FromSeconds(5)" />
                                </Grid>
                            </Expander>

                            <Expander Header="Sounds">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Nearby" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="_bNearbySound" TextSearch.TextPath="Id" ItemTemplate="{StaticResource SoundChoice}"
                                              Text="{Binding NearbySound, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Attack" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="_bAttackSound" TextSearch.TextPath="Id" ItemTemplate="{StaticResource SoundChoice}"
                                              Text="{Binding AttackSound, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Death" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="_bDeathSound" TextSearch.TextPath="Id" ItemTemplate="{StaticResource SoundChoice}"
                                              Text="{Binding DeathSound, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Warm" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="_bWarmSound" TextSearch.TextPath="Id" ItemTemplate="{StaticResource SoundChoice}"
                                              Text="{Binding WarmSound, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="Pick from the repo's sound list or type an id. The Sounds tab plays them."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </Expander>

                            <Expander Header="Flags, immunity and weakness">
                                <StackPanel Margin="4">
                                    <TextBlock Text="A filled box leaves the class default." Foreground="DimGray" FontSize="11" />
                                    <ItemsControl ItemsSource="{Binding Flags}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsThreeState="True" Margin="0,2,10,2" />
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Immunity" FontWeight="Bold" Margin="0,6,0,0" />
                                    <ItemsControl ItemsSource="{Binding Immunities}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,2,10,2" />
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Weakness" FontWeight="Bold" Margin="0,6,0,0" />
                                    <DockPanel Margin="0,2,0,0">
                                        <TextBlock Text="Weakness damage %" Style="{StaticResource FieldLabel}" />
                                        <TextBox Width="70" HorizontalAlignment="Left" Margin="0,3" Text="{Binding WeaknessDamage, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Writes Stats[EntityStat.MagicDamageTakenIncrease].Add(value, ModifierType.Constant). Empty writes nothing." />
                                    </DockPanel>
                                    <TextBlock Text="This raises all magic damage the creature takes, not only damage from its weaknesses."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Weaknesses}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" Margin="0,2,10,2" />
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Statuses, stat bonuses and spell immunity">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Statuses (AddStatus)" FontWeight="Bold" />
                                    <DataGrid ItemsSource="{Binding Statuses}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="40">
                                        <DataGrid.Columns>
                                            <local:ChoiceColumn x:Name="_bStatus" Header="Status" Binding="{Binding Name}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Stat bonuses" FontWeight="Bold" Margin="0,6,0,0" />
                                    <DataGrid ItemsSource="{Binding Stats}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="40">
                                        <DataGrid.Columns>
                                            <local:ChoiceColumn x:Name="_bStat" Header="Stat" Binding="{Binding Stat}" Width="*" />
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" />
                                            <local:ChoiceColumn x:Name="_bStatModifier" Header="How" Binding="{Binding Modifier}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="How: Base sets the stat (Stats[X].Base = value). Constant, AdditivePercent and MultiplicativePercent add to it (Stats[X].Add(value, ModifierType.How)), for example MagicDamageTakenIncrease +25."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="Immune to (AddImmunity)" FontWeight="Bold" Margin="0,6,0,0" />
                                    <DataGrid ItemsSource="{Binding SpellImmunities}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="40">
                                        <DataGrid.Columns>
                                            <local:ChoiceColumn x:Name="_bSpellImmunity" Header="Spell or item" Binding="{Binding Name}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Weak to (AddWeakness)" FontWeight="Bold" Margin="0,6,0,0" />
                                    <DataGrid ItemsSource="{Binding SpellWeaknesses}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="40">
                                        <DataGrid.Columns>
                                            <local:ChoiceColumn x:Name="_bSpellWeakness" Header="Spell or item" Binding="{Binding Name}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Attacks" IsExpanded="True">
                                <StackPanel Margin="4">
                                    <DataGrid ItemsSource="{Binding Attacks}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="60">
                                        <DataGrid.Columns>
                                            <local:ChoiceColumn x:Name="_bAttackType" Header="Type" Binding="{Binding Type}" />
                                            <DataGridTextColumn Header="Skill" Binding="{Binding Skill}" />
                                            <DataGridTextColumn Header="Min" Binding="{Binding MinDamage}" />
                                            <DataGridTextColumn Header="Max" Binding="{Binding MaxDamage}" />
                                            <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" />
                                            <DataGridTextColumn Header="Cooldown (s)" Binding="{Binding Cooldown}" />
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" />
                                            <local:ChoiceColumn x:Name="_bAttackEffect" Header="Effect" Binding="{Binding Effect}" />
                                            <DataGridTextColumn Header="Chance / value" Binding="{Binding EffectValue1}" />
                                            <DataGridTextColumn Header="Value 2" Binding="{Binding EffectValue2}" />
                                            <DataGridTextColumn Header="More effects" Binding="{Binding MoreEffects}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Effects: daze and prone take a chance; poison takes potency, chance; age takes amount, chance. More effects are written as code, for example new AttackDazeComponent(5). A message starting with $&quot; is kept as an interpolated string."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="Blocks" FontWeight="Bold" Margin="0,6,0,0" />
                                    <DataGrid ItemsSource="{Binding Blocks}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="60">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Roll" Binding="{Binding Roll}" />
                                            <DataGridTextColumn Header="Blocked by" Binding="{Binding Message}" Width="*" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Spells">
                                <StackPanel Margin="4">
                                    <DockPanel>
                                        <TextBlock Text="Cast chance" Style="{StaticResource FieldLabel}" />
                                        <TextBox Margin="0,3" Text="{Binding SpellChance, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="What goes in new CreatureSpellCollection(...), for example 25, 75" />
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding Spells}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="60">
                                        <DataGrid.Columns>
                                            <local:ChoiceColumn x:Name="_bSpell" Header="Spell" Binding="{Binding Spell}" />
                                            <DataGridTextColumn Header="Skill / arguments" Binding="{Binding Skill}" />
                                            <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" />
                                            <DataGridTextColumn Header="Cooldown (s)" Binding="{Binding Cooldown}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Skill / arguments is a skill level or named values such as skillLevel: 12, cost: 6."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Gear and brain" IsExpanded="True">
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Weapon" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="_bWeapon" Text="{Binding Weapon, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Shield" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="_bShield" Text="{Binding Shield, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="2" Text="Armor / robe" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="_bArmor" Text="{Binding Armor, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Helmet" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="_bHelmet" Text="{Binding Helmet, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="4" Text="Gauntlets" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" x:Name="_bGauntlets" Text="{Binding Gauntlets, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="5" Text="Boots" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="_bBoots" Text="{Binding Boots, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="6" Text="Brain (AI)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="6" Grid.Column="1" x:Name="_bBrain" Text="{Binding Brain, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Expander>

                            <Expander Header="Loot" IsExpanded="True">
                                <StackPanel Margin="4">
                                    <DockPanel>
                                        <TextBlock Text="Gold" Style="{StaticResource FieldLabel}" />
                                        <TextBox Margin="0,3" Text="{Binding Gold, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DataGrid ItemsSource="{Binding Loot}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                              HeadersVisibility="Column" MinHeight="60">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Pack" Binding="{Binding Pack}" />
                                            <DataGridCheckBoxColumn Header="At spawn" Binding="{Binding AtSpawn}" />
                                            <DataGridTextColumn Header="Loot pack or item" Binding="{Binding Item}" Width="*" />
                                            <DataGridTextColumn Header="Chance" Binding="{Binding Chance}" />
                                            <DataGridTextColumn Header="Mutator" Binding="{Binding Mutator}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="Loot packs like KeshmaiOre are defined in your segment, so type their names. Rows with the same pack number roll together in one AddLoot."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="Kept code" IsExpanded="True">
                                <StackPanel Margin="4">
                                    <TextBlock Text="Code the form has no field for, written back exactly as it is."
                                               Foreground="DimGray" FontSize="11" TextWrapping="Wrap" />
                                    <TextBlock Text="Before the creature" Style="{StaticResource SmallCaps}" />
                                    <TextBox Text="{Binding CodeBefore, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}" />
                                    <TextBlock Text="Other property lines (inside the creature's braces)" Style="{StaticResource SmallCaps}" />
                                    <TextBox Text="{Binding OtherInitializers, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}" />
                                    <TextBlock Text="Other statements (before the return)" Style="{StaticResource SmallCaps}" />
                                    <TextBox Text="{Binding OtherStatements, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Dialogue: the Shift+Right Click options (Gossips), part of the same form as the Builder -->
            <TabItem Header="Dialogue">
                <DockPanel x:Name="_dialogueRoot" Margin="4">
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Read from OnSpawn" Click="OnBuilderRead" Margin="0,3" />
                            <Button Content="Write to OnSpawn" Click="OnBuilderWrite" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="Builder and Dialogue are one form: Write saves both." Foreground="DimGray" FontSize="11" />
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" Foreground="DimGray" FontSize="11" Margin="0,0,0,4"
                                       Text="The options a player sees on Shift+Right Click. Each one can need a quest to be in a state, then runs its steps in order. Quests are tracked per player by name, so another creature's dialogue can check the same quest. Only humanoid creatures have these options." />

                            <Border x:Name="_dialogueWarningBox" Visibility="Collapsed" Background="#FFFFF4D6" BorderBrush="#FFE0A800"
                                    BorderThickness="1" Padding="6" Margin="0,0,0,6">
                                <TextBlock x:Name="_dialogueWarning" TextWrapping="Wrap" />
                            </Border>

                            <TextBlock Text="Options" FontWeight="Bold" />
                            <DockPanel x:Name="_dialogueOptionsList">
                                <StackPanel DockPanel.Dock="Right" Margin="4,0,0,0">
                                    <Button Content="Add" Click="OnDialogueAdd" Margin="0,0,0,3" />
                                    <Button Content="Remove" Click="OnDialogueRemove" Margin="0,0,0,3" />
                                    <Button Content="Up" Click="OnDialogueUp" Margin="0,0,0,3" />
                                    <Button Content="Down" Click="OnDialogueDown" Margin="0" />
                                </StackPanel>
                                <ListBox x:Name="_dialogueList" ItemsSource="{Binding Dialogue}" Height="130" />
                            </DockPanel>

                            <StackPanel x:Name="_dialogueOption" DataContext="{Binding SelectedItem, ElementName=_dialogueList}" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Menu text" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,3" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="1" Text="Only when quest" Style="{StaticResource FieldLabel}" />
                                    <DockPanel Grid.Row="1" Grid.Column="1">
                                        <ComboBox DockPanel.Dock="Right" x:Name="_dRequiredState" Width="100" IsEditable="False" SelectedItem="{Binding RequiredState}" />
                                        <ComboBox DockPanel.Dock="Right" x:Name="_dRequiredComparison" Width="60" IsEditable="False" Margin="4,3" SelectedItem="{Binding RequiredComparison}" />
                                        <ComboBox x:Name="_dRequiredQuest" DropDownOpened="OnQuestNamesOpened" Text="{Binding RequiredQuest, UpdateSourceTrigger=PropertyChanged}"
                                                  ToolTip="Leave empty for an option that always works" />
                                    </DockPanel>
                                    <TextBlock Grid.Row="2" Text="Otherwise say" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding OtherwiseSay, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="What the creature says when the quest isn't in that state (optional)" />
                                </Grid>

                                <TextBlock Text="Steps" FontWeight="Bold" Margin="0,6,0,0" />
                                <DataGrid x:Name="_dialogueSteps" ItemsSource="{Binding Steps}" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                          HeadersVisibility="Column" MinHeight="80" BeginningEdit="OnDialogueStepEdit">
                                    <DataGrid.Columns>
                                        <local:ChoiceColumn x:Name="_dStepKind" Header="Step" Binding="{Binding Kind}" />
                                        <local:ChoiceColumn x:Name="_dStepQuest" Header="Quest" Binding="{Binding Quest}" />
                                        <DataGridTextColumn Header="Text, amount, item, state or code" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="Selected step" Style="{StaticResource SmallCaps}" />
                                <TextBox DataContext="{Binding SelectedItem, ElementName=_dialogueSteps}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CodeBox}" />
                                <TextBlock TextWrapping="Wrap" Foreground="DimGray" FontSize="11"
                                           Text="Say: the creature speaks to the player. Set quest: pick the quest and put Enabled, Started, Completed or Not started in the last column. Give gold / experience: an amount. Give item: an item class such as Longsword. Message player: gold text only they see. Code: any C#, using humanoid and player. Text starting with $&quot; can use {player.Name}." />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Creature options: each row edits one line of the OnSpawn script -->
            <TabItem Header="Creature">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid x:Name="_optionsGrid" Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Body and hue together: the body sprite drawn with the hue, the way it is tinted in game -->
            <TabItem Header="Body &amp; Hue">
                <DockPanel Margin="6">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="sprite preview with tint" Foreground="DimGray" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="Body &amp; Hue" FontWeight="Bold" FontSize="14" />
                    </DockPanel>

                    <Grid DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="160" Height="160" VerticalAlignment="Top" Margin="0,0,10,0" BorderBrush="Gray" BorderThickness="1" CornerRadius="3"
                                Background="{StaticResource Checker}">
                            <Image x:Name="_huePreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="4" />
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="_bodyTitle" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="_bodyInfo" Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6" />

                            <TextBlock Text="BODY ID" Style="{StaticResource SmallCaps}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="_bodyId" Width="80" Margin="0,3" VerticalContentAlignment="Center" TextChanged="OnBodyIdChanged" />
                                <Button x:Name="_browseBodies" Content="Browse bodies…" Click="OnBrowseBodies" FontWeight="Bold" Margin="6,3,0,3" />
                            </StackPanel>

                            <TextBlock Text="HUE" Style="{StaticResource SmallCaps}" Margin="0,6,0,0" />
                            <ComboBox x:Name="_hueMode" IsEditable="False" SelectionChanged="OnHueModeChanged" />

                            <WrapPanel Margin="0,4,0,0">
                                <xctk:ColorPicker x:Name="_huePicker" Width="40" Height="24" UsingAlphaChannel="True" ShowDropDownButton="False"
                                                  DisplayColorAndName="False" SelectedColorChanged="OnHueColorChanged" Margin="0,0,6,4"
                                                  ToolTip="Pick any color" />
                                <Border Background="#FF2B2B2B" CornerRadius="3" Padding="6,2" Margin="0,0,6,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="_hueArgb" FontFamily="Consolas" Foreground="#FFE8C060" />
                                </Border>
                                <ItemsControl x:Name="_hueSwatches">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Width="22" Height="22" Padding="0" Margin="0,0,4,4" Background="{Binding Brush}" ToolTip="{Binding Name}"
                                                BorderBrush="Gray" Click="OnHueSwatch" />
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,8,0,0">
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="A" Style="{StaticResource SmallCaps}" /><TextBox x:Name="_hueA" TextChanged="OnHueComponentChanged" /></StackPanel>
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="R" Style="{StaticResource SmallCaps}" /><TextBox x:Name="_hueR" TextChanged="OnHueComponentChanged" /></StackPanel>
                        <StackPanel Margin="0,0,6,0"><TextBlock Text="G" Style="{StaticResource SmallCaps}" /><TextBox x:Name="_hueG" TextChanged="OnHueComponentChanged" /></StackPanel>
                        <StackPanel><TextBlock Text="B" Style="{StaticResource SmallCaps}" /><TextBox x:Name="_hueB" TextChanged="OnHueComponentChanged" /></StackPanel>
                    </UniformGrid>

                    <TextBlock DockPanel.Dock="Top" Foreground="DimGray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="The preview multiplies the sprite by the hue, which is how a tinted sprite is drawn. White means no change." />

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Set body" Click="OnSetBody" Margin="0,3" />
                        <Button Content="Set hue" Click="OnSetHue" />
                        <Button Content="Set both" Click="OnSetBodyAndHue" FontWeight="Bold" />
                    </StackPanel>

                    <!-- the body gallery, shown by Browse bodies -->
                    <DockPanel x:Name="_bodyBrowser" Visibility="Collapsed" Margin="0,6,0,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="_bodySearch" TextChanged="OnBodySearchChanged" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="Click a body to preview it. Double-click to pick it and close the list." Foreground="DimGray" FontSize="11" Margin="0,4,0,0" />
                    <ListBox x:Name="_bodies"
                             MouseDoubleClick="OnBodyDoubleClick"
                             SelectionChanged="OnBodySelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <wpfToolkit:VirtualizingWrapPanel SpacingMode="None" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="78" ToolTip="{Binding Texture}">
                                    <Border Width="64" Height="64" Background="#FFE8E8E8">
                                        <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>
                </DockPanel>
            </TabItem>

            <TabItem Header="Sounds">
                <DockPanel Margin="4">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Search" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="_soundSearch" TextChanged="OnSoundSearchChanged" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="DimGray" FontSize="11" Margin="0,4,0,0"
                               Text="A creature's attack and death sounds come from its class, so OnSpawn can't set them. Copy an id for traps, OnDeath and other scripts." />
                    <ListView x:Name="_sounds">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Content="▶" Click="OnPlaySound" Margin="0,1,6,1" ToolTip="Play" />
                                    <Button DockPanel.Dock="Right" Content="Copy id" Click="OnCopySoundId" Margin="6,1,0,1" />
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding Id, Mode=OneWay}" FontFamily="Consolas" />
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Category, Mode=OneWay}" Foreground="Gray" FontSize="10" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
